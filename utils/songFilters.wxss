/* 沿用琴谱列表的粉色选中态，筛选收纳在底部面板。 */
.browse-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 24rpx; }
.browse-filter { margin: 0; padding: 0 24rpx; font-size: 26rpx; line-height: 76rpx; border-radius:38rpx; background:var(--card-bg,#fff); color:var(--text-main,#333); }
.browse-filter::after, .filter-sheet button::after { border:0; }
.browse-filter.is-active { color:var(--accent-text); background:var(--soft); }
.browse-sort { padding: 20rpx 0 20rpx 20rpx; font-size: 26rpx; color:var(--text-secondary,#666); }
.browse-summary { display: flex; align-items: baseline; justify-content: space-between; gap: 20rpx; padding: 22rpx 0; color:var(--text-secondary,#666); font-size: 24rpx; }
.browse-summary > text:first-child { flex: 1; min-width: 0; }
.browse-reset { color:var(--accent-text); flex-shrink: 0; padding: 12rpx 0; }
.stored-date { margin-bottom: 8rpx; }
.empty-state { display: flex; flex-direction: column; gap: 20rpx; color:var(--text-muted,#777); }
.filter-overlay { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; background:rgba(0,0,0,.35); display: flex; align-items: flex-end; }
.filter-sheet { box-sizing: border-box; width: 100%; border-radius:32rpx 32rpx 0 0; background:var(--card-bg,#fff); padding: 28rpx var(--page-gutter,30rpx); padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); }
.sheet-heading { display: flex; justify-content: space-between; align-items: center; font-size: 34rpx; font-weight: 600; color:var(--text-main,#333); margin-bottom: 24rpx; }
.filter-sheet .sheet-close { margin: 0; padding: 0 12rpx; background:transparent; color:var(--text-secondary,#666); font-size: 26rpx; font-weight: normal; }
.sheet-options { max-height: 55vh; }
.sheet-group { margin-bottom: 30rpx; }
.sheet-label { display: block; font-size: 26rpx; color:var(--text-secondary,#666); margin-bottom: 16rpx; }
.sheet-choices { display: flex; flex-wrap: wrap; gap: 14rpx; }
.filter-sheet .sheet-choice { margin: 0; padding: 0 24rpx; font-size: 26rpx; line-height: 76rpx; border-radius:16rpx; background:var(--page-bg,#f8f8f8); color:var(--text-main,#333); border:2rpx solid transparent; }
.filter-sheet .sheet-choice.chosen { background:var(--soft); border-color:var(--primary); color:var(--accent-text); }
.sheet-actions { display: flex; gap: 20rpx; padding-top: 12rpx; }
.filter-sheet .sheet-reset, .filter-sheet .sheet-confirm { margin: 0; font-size: 28rpx; line-height: 84rpx; border-radius:42rpx; }
.filter-sheet .sheet-reset { flex: 1; background:var(--page-bg,#f8f8f8); color:var(--text-secondary,#666); }
.filter-sheet .sheet-confirm { flex: 2; background:var(--primary); color:#fff; }

.filter-sheet{max-height:90vh;overflow-y:auto}
.sheet-heading>text{flex:1;min-width:0}
.filter-sheet .sheet-close{flex:0 0 auto;width:auto;min-width:64rpx;margin-left:auto;padding:0;text-align:right}
.sheet-choices{display:flex;flex-wrap:wrap;gap:14rpx}
.filter-sheet .sheet-choice{flex:0 0 calc((100% - 14rpx) / 2);min-width:0;padding:0 12rpx}
.filter-sheet .sheet-confirm{color:var(--on-primary,#fff)}
