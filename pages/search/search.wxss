page {
  background-color:var(--page-bg,#f8f8f8);
  box-sizing: border-box;
}
view, text, input { box-sizing: border-box; }

.container {
  padding: 30rpx;
  width: 100%;
}

/* 搜索框 */
.search-bar {
  margin-bottom: 40rpx;
}

.search-input-box {
  background-color:var(--card-bg,#fff);
  height: 80rpx;
  border-radius:40rpx; /* 圆角胶囊形状 */
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.05);
}

.search-icon {
  margin-right: 20rpx;
  font-size: 32rpx;
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color:var(--text-main,#333);
}

.clear-btn {
  width: 40rpx;
  height: 40rpx;
  background-color:var(--border,#ccc);
  color:#fff;
  border-radius:50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 24rpx;
}

/* 结果列表 */
.section-header {
  font-size: 28rpx;
  color:var(--text-muted,#999);
  margin-bottom: 20rpx;
  padding-left: 0;
}

/* 复用卡片样式 (简化版) */
.song-card {
  background-color:var(--card-bg,#fff);
  border-radius:16rpx;
  padding: 24rpx 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-info {
  display: flex;
  flex-direction: column;
  flex: 1;
  margin-right: 20rpx;
}

.song-title { font-size: 32rpx; font-weight: bold; color:var(--text-main,#333); margin-bottom: 4rpx; }
.song-artist { font-size: 24rpx; color:var(--text-secondary,#666); margin-bottom: 4rpx; }
.song-meta { font-size: 22rpx; color:var(--text-muted,#999); }

.card-tag {
  font-size: 22rpx; padding: 4rpx 12rpx; border-radius:8rpx;
}
.card-tag.blank { background-color:var(--text-score-bg,#e3f2fd); color:var(--text-score-color,#1976d2); }
.card-tag.paper { background-color:var(--paper-bg,#f3e5f5); color:var(--paper-color,#ab47bc); }
.card-tag.image { background-color:var(--image-bg,#fff7e6); color:#fa8c16; }

/* 空状态 */
.empty-result, .empty-start {
  margin-top: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  color:var(--text-muted,#ccc);
  font-size: 28rpx;
}

.empty-result text:first-child, .empty-start .big-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.search-icon-img{width:32rpx;height:32rpx;margin-right:14rpx;flex-shrink:0}
.empty-search-icon{width:72rpx;height:72rpx;margin-bottom:20rpx;opacity:.65}

.card-info,.search-input{min-width:0}.song-title{overflow-wrap:anywhere}

.clear-btn{display:flex;align-items:center;justify-content:center;flex-shrink:0;line-height:1}
