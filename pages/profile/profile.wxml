<view class="container">
  
  <!-- ✨ 统一标题样式 -->
  <view class="header">
    <text class="header-title">Lyra吉他谱本</text>
  </view>

  <!-- 2. 数据统计卡片 (保留) -->
  <view class="section-title">练习统计</view>
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-num">{{counts.practicing}}</text>
      <text class="stat-label">正在练</text>
    </view>
    <view class="line"></view>
    <view class="stat-item">
      <text class="stat-num">{{counts.finished}}</text>
      <text class="stat-label">已练完</text>
    </view>
  </view>

  <!-- 3. 小工具 (根据 Page 9 新增) -->
  <view class="section-title">小工具</view>
  <view class="menu-list">
  
  <!-- ✨ 新增：随机抽查 -->
  <view class="menu-item" bindtap="randomPick">
      <view class="menu-left">
        <text class="menu-icon">🎲</text>
        <text>今天练什么？</text>
      </view>
      <text class="arrow">></text>
    </view>
    
    <view class="menu-item" bindtap="goToTuner">
      <view class="menu-left">
        <text class="menu-icon">🎸</text>
        <text>吉他定音器</text>
      </view>
      <text class="arrow">></text>
    </view>
    <view class="menu-item" bindtap="goToMetronome">
      <view class="menu-left">
        <text class="menu-icon">⏱️</text>
        <text>节拍器</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>


  <!-- 4. 其他 (回收站、关于) -->
  <view class="section-title">其他</view>
  <view class="menu-list">
    <!-- 回收站 -->
    <view class="menu-item" bindtap="goToTrash">
      <view class="menu-left">
        <text class="menu-icon">🗑️</text>
        <text>回收站</text>
      </view>
      <view class="menu-right">
        <text class="badge" wx:if="{{counts.deleted > 0}}">{{counts.deleted}}</text>
        <text class="arrow">></text>
      </view>
    </view>


    <view class="menu-item" bindtap="exportAll">
      <view class="menu-left">
        <text class="menu-icon">📦</text>
        <text>导出全部数据（一次性）</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="migrateToLocal">
      <view class="menu-left">
        <text class="menu-icon">📥</text>
        <text>一键迁移到本地（一次性）</text>
      </view>
      <text class="arrow">></text>
    </view>

    <view class="menu-item" bindtap="showAbout">
      <view class="menu-left">
        <text class="menu-icon">ℹ️</text>
        <text>关于</text>
      </view>
      <text class="arrow">></text>
    </view>
  </view>
</view>