<page-meta page-style="background-color: {{pageBackground}};" />
<view class="theme-root" style="{{themeStyle}}">
<view class="container">
  
  <view wx:if="{{statsError}}" class="feedback"><text>{{statsError}}</text><button bindtap="calculateStats">重试统计</button></view>
  <view class="stats-card" wx:else>
    <view class="stat-item">
      <text class="stat-num">{{counts.songs}}</text>
      <text class="stat-label">曲谱数</text>
    </view>
    <view class="line"></view>
    <view class="stat-item">
      <text class="stat-num">{{counts.playlists}}</text>
      <text class="stat-label">歌单数</text>
    </view>
  </view>

  <view class="section-title">外观</view>
  <view class="menu-list"><view class="menu-item" bindtap="openTheme"><view class="menu-left"><image class="menu-icon-img" src="/images/remix/palette-gray.png"/><text>主题外观</text></view><view class="menu-right"><text class="muted">{{appearanceName}} · {{themeName}}</text><text class="arrow">›</text></view></view></view>
  <!-- 3. 小工具 (根据 Page 9 新增) -->
  <view class="section-title">小工具</view>
  <view class="menu-list">
  
  <!-- ✨ 新增：随机抽查 -->
  <view class="menu-item" bindtap="randomPick">
      <view class="menu-left">
        <image class="menu-icon-img" src="/images/remix/dice-gray.png" />
        <text>今天练什么？</text>
      </view>
      <text class="arrow">›</text>
    </view>
    
    <view class="menu-item" bindtap="goToTuner">
      <view class="menu-left">
        <image class="menu-icon-img" src="/images/remix/tuner-gray.png" />
        <text>吉他定音器</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="menu-item" bindtap="goToMetronome">
      <view class="menu-left">
        <image class="menu-icon-img" src="/images/remix/timer-gray.png" />
        <text>节拍器</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>


  <!-- 4. 其他 (回收站、关于) -->
  <view class="section-title">其他</view>
  <view class="menu-list">
    <!-- 回收站 -->
    <view class="menu-item" bindtap="goToTrash">
      <view class="menu-left">
        <image class="menu-icon-img" src="/images/remix/trash-gray.png" />
        <text>回收站</text>
      </view>
      <view class="menu-right">
        <text class="badge" wx:if="{{counts.deleted > 0}}">{{counts.deleted}}</text>
        <text class="arrow">›</text>
      </view>
    </view>


    <view class="menu-item" bindtap="showAbout">
      <view class="menu-left">
        <image class="menu-icon-img" src="/images/remix/info-gray.png" />
        <text>关于</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>

<view wx:if="{{showTheme}}" class="filter-overlay" catchtap="closeTheme" catchtouchmove="noop"><view class="filter-sheet" catchtap="noop">
  <view class="sheet-heading theme-sheet-heading"><text>主题外观</text><button class="sheet-close" bindtap="closeTheme">完成</button></view>
  <text class="sheet-label">显示模式</text>
  <view class="appearance-options">
    <button class="appearance-option {{appearance === 'system' ? 'chosen' : ''}}" data-id="system" bindtap="chooseAppearance">跟随系统</button>
    <button class="appearance-option {{appearance === 'light' ? 'chosen' : ''}}" data-id="light" bindtap="chooseAppearance">白天</button>
    <button class="appearance-option {{appearance === 'dark' ? 'chosen' : ''}}" data-id="dark" bindtap="chooseAppearance">黑夜</button>
  </view>
  <text class="sheet-label">主题配色</text>
  <view class="theme-choice {{themeId === 'pink' ? 'chosen' : ''}}" data-id="pink" bindtap="chooseTheme"><view class="theme-swatch pink"></view><text class="theme-name">经典粉色</text><text class="theme-check">{{themeId === 'pink' ? '✓' : '○'}}</text></view>
  <view class="theme-choice {{themeId === 'neutral' ? 'chosen' : ''}}" data-id="neutral" bindtap="chooseTheme"><view class="theme-swatch neutral"></view><text class="theme-name">中性黑灰</text><text class="theme-check">{{themeId === 'neutral' ? '✓' : '○'}}</text></view>
</view></view>

</view>
