@import "../../utils/songFilters.wxss";
page {
  background-color:var(--page-bg,#f8f8f8);
  box-sizing: border-box;
}

.container {
  padding: 30rpx;
}

/* ✨ 统一标题样式 */
.header {
  margin-bottom: 40rpx;
  width: 100%;
  text-align: center;
}

.header-title {
  font-size: 48rpx;
  font-weight: bold;
  color:var(--text-main,#333);
  display: block;
}

.section-title {
  font-size: 30rpx;
  color:var(--primary); /* 用你的主题色 */
  font-weight: bold;
  margin-bottom: 20rpx;
  margin-top: 40rpx;
  padding-left: 0;
}

/* 2. 统计卡片 */
.stats-card {
  background-color:var(--card-bg,#fff);
  border-radius:20rpx;
  padding: 40rpx 0;
  display: flex;
  justify-content: space-around; /* 平均分布 */
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 40%;
}

.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color:var(--text-main,#333);
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color:var(--text-muted,#999);
}

.line {
  width: 2rpx;
  height: 60rpx;
  background-color:var(--border,#eee);
}

/* 3. 菜单列表 */
.menu-list {
  background-color:var(--card-bg,#fff);
  border-radius:20rpx;
  padding: 0 30rpx; /* 上下0，左右30 */
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.03);
}

.menu-item {
  height: 110rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom:2rpx solid var(--border,#f5f5f5);
}

/* 最后一个菜单项不要底边线 */
.menu-item:last-child {
  border-bottom:none;
}

.menu-left {
  display: flex;
  align-items: center;
  font-size: 32rpx;
  color:var(--text-main,#333);
}

.menu-right {
  display: flex;
  align-items: center;
}

.badge {
  background-color:#ff4d4f;
  color:white;
  font-size: 24rpx;
  padding: 4rpx 14rpx;
  border-radius:20rpx;
  margin-right: 16rpx;
}

.arrow {
  color:var(--text-muted,#ccc);
  font-size: 32rpx;
}
.theme-choice{height:112rpx;display:flex;align-items:center;gap:24rpx;border:2rpx solid var(--border,#eee);padding:0 28rpx;border-radius:20rpx;margin-top:24rpx}.theme-choice.chosen{border-color:var(--primary);background:var(--soft)}.theme-swatch{width:56rpx;height:56rpx;border-radius:50%;flex-shrink:0}.theme-name{flex:1;font-size:32rpx;color:var(--text-main,#333)}.theme-check{width:40rpx;text-align:center;color:var(--primary);font-size:32rpx}.pink{background:#FA7298}.neutral{background:#333333}.menu-icon-img{width:36rpx;height:36rpx;margin-right:20rpx;flex-shrink:0}
.theme-sheet-heading{position:relative;padding-right:96rpx}.theme-sheet-heading .sheet-close{position:absolute;right:0;top:50%;transform:translateY(-50%);width:auto;min-width:0;margin:0;padding:0;color:var(--accent-text)}

.appearance-options{display:flex;gap:12rpx;margin:16rpx 0 30rpx}
.appearance-option{flex:1;padding:0 8rpx;font-size:26rpx;line-height:80rpx;border-radius:16rpx;background:var(--surface-bg);color:var(--text-main);border:2rpx solid transparent}
.appearance-option.chosen{border-color:var(--primary);background:var(--soft);color:var(--accent-text)}
.menu-left{min-width:0;flex-shrink:0}.menu-right{min-width:0;gap:12rpx}.menu-right .muted{margin-top:0;font-size:22rpx;text-align:right}

.arrow{width:24rpx;flex:0 0 24rpx;display:flex;align-items:center;justify-content:center;line-height:1}
