<page-meta page-style="background-color: {{pageBackground}};" />
<view class="theme-root" style="{{themeStyle}}">
<view class="container">
  <view class="menu-list">
    <view class="menu-card" bindtap="goToBlank">
      <view class="icon-box"><image src="/images/remix/score-{{themeIcon}}.png" class="menu-icon-img" /></view>
      <view class="text-box"><text class="card-title">添加自制谱</text><text class="card-desc">记录文字、和弦与歌词</text></view>
      <text class="arrow">›</text>
    </view>
    <!-- 选项 2：相册导入 -->
    <view class="menu-card" bindtap="goToImage">
      <view class="icon-box">
        <image src="/images/remix/camera-{{themeIcon}}.png" class="menu-icon-img" />
      </view>
      <view class="text-box">
        <text class="card-title">导入图片 / PDF</text>
        <text class="card-desc">支持相册、聊天图片及 PDF 文件</text>
      </view>
      <text class="arrow">›</text>
    </view>

    <!-- 选项 3：纸质谱 -->
    <view class="menu-card" bindtap="goToPaper">
      <view class="icon-box">
        <image src="/images/remix/book-{{themeIcon}}.png" class="menu-icon-img" />
      </view>
      <view class="text-box">
        <text class="card-title">纸质谱归档</text>
        <text class="card-desc">记录书名页码，支持拍照备份</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>
</view>
</view>
