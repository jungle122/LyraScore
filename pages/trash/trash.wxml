<page-meta page-style="background-color: {{pageBackground}};" />
<view class="theme-root" style="{{themeStyle}}"><view class="container">
  <view class="page-toolbar trash-toolbar"><text class="section-count">{{trashList.length}} 首已删除曲谱</text><button class="danger-button trash-clear" bindtap="clearAll" disabled="{{busy || !trashList.length}}">清空</button></view>
  <text class="muted">可恢复到曲谱库，或手动彻底删除。不会自动清理。</text>
  <view wx:if="{{loading}}" class="feedback">正在加载…</view>
  <view wx:if="{{error}}" class="feedback"><text>{{error}}</text><button bindtap="load" disabled="{{busy}}">重新加载</button></view>
  <view class="trash-card" wx:for="{{trashList}}" wx:key="_id">
    <text class="score-title">{{item.title}}</text><text class="muted">删除日期：{{item.deletedText}}</text>
    <text wx:if="{{item.purgeStarted}}" class="purge-tip">清理未完成，请重试彻底删除；此曲谱已无法恢复。</text>
    <view class="trash-actions"><button class="button-quiet compact" bindtap="recoverSong" data-id="{{item._id}}" disabled="{{busy || item.purgeStarted}}">恢复</button><button class="danger-button" bindtap="deleteForever" data-id="{{item._id}}" disabled="{{busy}}">{{item.purgeStarted ? '重试彻底删除' : '彻底删除'}}</button></view>
  </view>
  <view wx:if="{{!loading && !error && !trashList.length}}" class="blank-state"><text class="blank-title">回收站是空的</text><text>删除的曲谱会暂存在这里</text></view>
</view></view>
