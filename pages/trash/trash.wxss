.container{padding:30rpx}.trash-card{padding:28rpx var(--page-gutter,30rpx);background:var(--card-bg,#fff);border-radius:20rpx;margin-top:24rpx}.trash-actions{display:flex;justify-content:flex-end;gap:20rpx;margin-top:20rpx}.danger-button{margin:0;padding:0 24rpx;font-size:26rpx;line-height:76rpx;background:var(--danger-bg,#fff0f0);color:var(--danger,#c23838);border-radius:38rpx}.purge-tip{display:block;color:var(--danger,#c23838);font-size:24rpx;margin-top:16rpx}
.trash-toolbar{width:100%;display:flex;align-items:center}.trash-toolbar .section-count{flex:1;min-width:0}.trash-clear{width:160rpx;height:76rpx;line-height:76rpx;flex:0 0 160rpx;margin:0 0 0 auto;padding:0;text-align:center}
