<page-meta page-style="background-color: {{pageBackground}};" />
<view class="theme-root" style="{{themeStyle}}">
<view wx:if="{{loadError}}" class="feedback"><text>{{loadError}}</text><button bindtap="retryLoad">重试</button></view>
<view class="container" wx:if="{{song}}">
  
  <!-- 顶部导航 -->
  <view class="nav-bar" wx:if="{{song}}">
    <!-- 点击这里，打开抽屉 -->
    <view class="menu-btn" bindtap="openDrawer">
      <text style="font-weight:bold; font-size: 40rpx;">···</text>
    </view>
  </view>

  <!-- 标题区 -->
  <view class="header-area">
    <text class="title" user-select="true">{{song.title}}</text>
    <text class="artist" user-select="true">{{song.artist ? song.artist : ' - '}}</text>
  </view>

  <!-- 参数区 -->
  <view class="meta-section" wx:if="{{song.type === 'blank'}}">
    <view class="meta-row">
      <view class="meta-item"><text class="label">选调</text><text class="value">{{song.key}}</text></view>
      <view class="meta-item"><text class="label">原调</text><text class="value">{{song.originalKey}}</text></view>
      <view class="meta-item"><text class="label">Capo</text><text class="value">{{song.capo}}</text></view>
    </view>
    <view class="meta-row">
      <view class="meta-item"><text class="label">拍号</text><text class="value">{{song.timeSignature}}</text></view>
      <view class="meta-item"><text class="label">BPM</text><text class="value">{{song.bpm}}</text></view>
      <view class="meta-item"><text class="label">调弦</text><text class="value">{{song.tuning}}</text></view>
    </view>
  </view>

  <view class="paper-info" wx:if="{{song.type === 'paper'}}">
    <text>📍 曲谱位于：{{song.location}}</text>
  </view>

  <!-- ✨ 图片谱展示 (遍历显示，点击全屏) -->
  <view class="image-content" wx:if="{{song.imagePaths.length > 0}}">
    <block wx:for="{{song.imagePaths}}" wx:key="*this">
      <image 
        src="{{item}}" 
        mode="widthFix" 
        lazy-load="true" 
        style="width: 100%; display: block; margin-bottom: 20rpx; background-color: var(--surface-bg); min-height: 400rpx;"
        bindtap="previewImage"
        data-current="{{item}}"
      />
    </block>
  </view>

  <view class="file-list" wx:if="{{song.filePaths && song.filePaths.length > 0}}">
    <view class="file-item" wx:for="{{song.filePaths}}" wx:key="*this">
      <view class="file-info" bindtap="openFile" data-path="{{item}}">
        <text class="file-name">PDF 文件 {{index + 1}}</text>
      </view>
    </view>
  </view>
  
  <!-- 歌词区 -->
  <!-- ✨ 核心：style="font-size: {{fontSize}}rpx" -->
  <!-- 这样我们拖动滑块，字就会变大变小 -->
  <text 
    class="content-area" 
    user-select="true" 
    style="font-size: {{fontSize}}rpx"
    wx:if="{{song.content}}" 
  >{{song.content}}</text>
  
  <!-- ✨【重点】备注应该放在这里！在 container 的末尾，和歌词并列 -->
  <view class="reader-comment" wx:if="{{song.comment}}">
    <view class="comment-tag">MEMO</view>
    <text class="comment-text" user-select="true">{{song.comment}}</text>
  </view>
</view>

<!-- ========================= -->
<!-- ✨ 自定义抽屉菜单 (完整版) -->
<!-- ========================= -->

<view class="drawer-mask" wx:if="{{showDrawer && song}}" bindtap="closeDrawer"></view>

<view class="drawer-panel" wx:if="{{showDrawer && song}}">
  <text class="drawer-title">更多操作</text>

  <view class="menu-group">
    <view class="menu-item" bindtap="openPlaylistPicker">加入歌单</view>
    <view class="menu-item" bindtap="goToEdit">编辑曲谱</view>
  </view>

  <view class="divider"></view>

  <!-- 屏幕常亮区 -->
  <view class="control-group">
    <view class="control-header">
      <text class="control-label">屏幕常亮</text>
      <switch checked="{{isKeepScreenOn}}" bindchange="toggleKeepScreen" color="{{themePrimary}}"/>
    </view>
  </view>

  <view class="divider"></view>

  <!-- 2. 字体缩放区 -->
  <view class="control-group">
    <view class="control-header">
      <text class="control-label">字体大小</text>
      <text class="control-value">{{fontSize}}</text>
    </view>
    <slider 
      min="24" max="60" value="{{fontSize}}" 
      block-size="18"
      bindchanging="onZoomChange" 
     activeColor="{{themePrimary}}"/>
  </view>

<!-- 3. 触感节拍器区 -->
<view class="control-group">
      <view class="control-header">
        <text class="control-label">节拍器 (声音)</text>
        <switch checked="{{isPlaying}}" bindchange="toggleMetronome" color="{{themePrimary}}"/>
      </view>
      
      <view wx:if="{{isPlaying}}" style="margin-top: 20rpx;">
        <view class="control-header">
          <text class="control-sub-label">速度 (BPM)</text>

          <!-- ✨ 核心修改：把文本换成输入框 -->
          <!-- type="number"：让手机弹出数字键盘 -->
          <!-- value="{{currentBpm}}"：和滑块共享同一个数据源 -->
          <!-- bindinput="onBpmInput"：每次打字时，都去执行 JS 里的 onBpmInput 函数 -->
          <input 
            class="bpm-input" 
            type="number" 
            value="{{currentBpm}}" 
            bindinput="onBpmInput" 
          />
        </view>
        <slider 
          min="40" max="200" value="{{currentBpm}}" 
          block-size="18"
          bindchanging="changeBpm" 
         activeColor="{{themePrimary}}"/>
      </view>
    </view>

  <view class="divider"></view>

  <!-- 4. 底部删除 -->
  <view class="menu-item delete" bindtap="deleteSong">移入回收站</view>
</view><playlist-picker visible="{{showPlaylistPicker}}" song-ids="{{pickerSongIds}}" theme-style="{{themeStyle}}" bindclose="closePlaylistPicker" />

</view>
