<wxs src="./finished.wxs" module="utils" />
<view class="container">
  
  <view class="top-bar" wx:if="{{!isEditMode}}">
    <!-- 伪搜索框：其实是一个按钮 -->
    <view class="search-entry" bindtap="goToSearch">
      <view class="search-box">
        <text class="search-icon">🔍</text> 
        <text class="search-text">搜索曲谱...</text>
      </view>
    </view>
    <view class="manage-btn" bindtap="toggleEditMode">管理</view>
  </view>

  <view class="manage-toolbar" wx:if="{{isEditMode}}">
    <view class="toolbar-left" bindtap="toggleSelectAll">
      <view class="select-all-circle {{selectedIds.length > 0 && selectedIds.length === songList.length ? 'checked' : ''}}"></view>
      <text class="toolbar-text">全选</text>
    </view>
    <text class="toolbar-count">已选 {{selectedIds.length}}</text>
    <view class="toolbar-done" bindtap="toggleEditMode">完成</view>
  </view>

  <!-- 筛选和排序胶囊 -->
  <view class="filter-sort">
    <!-- 行1：乐器筛选 -->
    <scroll-view scroll-x="true" class="filter-bar">
      <view class="filter-capsule {{selectedInstrument === 'all' ? 'active' : ''}}" bindtap="onFilterChange" data-value="all">全部</view>
      <view class="filter-capsule {{selectedInstrument === 'guitar' ? 'active' : ''}}" bindtap="onFilterChange" data-value="guitar">🎸吉他</view>
      <view class="filter-capsule {{selectedInstrument === 'ukulele' ? 'active' : ''}}" bindtap="onFilterChange" data-value="ukulele">🥥尤克里里</view>
    </scroll-view>
    <!-- 行2：风格筛选 -->
    <scroll-view scroll-x="true" class="filter-bar">
      <view class="filter-capsule {{selectedStyle === 'all' ? 'active' : ''}}" bindtap="onStyleChange" data-value="all">全部</view>
      <view class="filter-capsule {{selectedStyle === 'fingerstyle' ? 'active' : ''}}" bindtap="onStyleChange" data-value="fingerstyle">🎤弹唱</view>
      <view class="filter-capsule {{selectedStyle === 'picking' ? 'active' : ''}}" bindtap="onStyleChange" data-value="picking">🎸指弹</view>
    </scroll-view>
    <!-- 行3：排序 -->
    <scroll-view scroll-x="true" class="sort-bar">
      <view class="filter-capsule {{selectedSort === 'newest' ? 'active' : ''}}" bindtap="onSortChange" data-value="newest">最新存</view>
      <view class="filter-capsule {{selectedSort === 'oldest' ? 'active' : ''}}" bindtap="onSortChange" data-value="oldest">最久练</view>
      <view class="filter-capsule {{selectedSort === 'name' ? 'active' : ''}}" bindtap="onSortChange" data-value="name">按名字 (A-Z)</view>
    </scroll-view>
  </view>

  <!-- 列表结构完全复用 -->
  <view class="song-list">
    <block wx:for="{{songList}}" wx:key="_id">
      <view class="song-card" bindtap="onCardTap" data-id="{{item.id}}" data-uid="{{item._id}}">
        <view class="select-circle {{utils.isSelected(selectedIds, item._id) ? 'checked' : ''}}" wx:if="{{isEditMode}}" catchtap="toggleSelectItem" data-uid="{{item._id}}"></view>
        <view class="card-info">
          <text class="song-title">{{item.title}}</text>
          <text class="song-artist">{{item.artist ? item.artist : ' - '}}</text>
          <text class="song-meta" wx:if="{{item.type === 'paper'}}">📍 {{item.location}}</text>
          <text class="song-meta" wx:if="{{item.type === 'blank'}}">🎼 {{item.key}}调 | {{item.bpm}} BPM</text>
        </view>
        <view class="card-tag {{item.type}}">
          {{item.type === 'blank' ? '自制' : (item.type === 'paper' ? '归档' : '图片')}}
        </view>
      </view>
    </block>
  </view>

  <!-- 空状态修改 -->
  <view class="empty-state" wx:if="{{songList.length === 0}}">
    <text>还没有练完的曲谱</text>
    <text>快去练习吧！</text>
  </view>

  <view class="action-bar" wx:if="{{isEditMode}}">
    <view class="action-btn delete-btn {{selectedIds.length === 0 ? 'disabled' : ''}}" bindtap="batchDelete">删除</view>
    <view class="action-btn {{selectedIds.length === 0 ? 'disabled' : ''}}" bindtap="batchMove">移至正在练</view>
  </view>

</view>